{
  "name": "mobile-oauth02-example-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch index.ts --allow-private-rita-http",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env src/database/migrate.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "^5.9.3"
  }
}
