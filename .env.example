# Máy chủ External Backend (C)
# Các biến trong nhóm này là tùy chọn. Giá trị mẫu cũng là mặc định.
# HOST=127.0.0.1 chỉ lắng nghe cục bộ. Dùng địa chỉ mà D truy cập được khi thử trên thiết bị.
HOST=127.0.0.1
PORT=3005
# LOG_LEVEL nhận info hoặc debug.
LOG_LEVEL=info

# PostgreSQL riêng cho C. Chạy npm run db:migrate trước khi khởi động.
# Nếu mật khẩu là one@two, viết one%40two trong URI. Giữ dấu @ trước host.
# Ví dụ: postgresql://user:one%40two@localhost/db
DATABASE_URL=postgresql://partner:replace-with-local-password@127.0.0.1:5432/rita_partner
# Khóa mã hóa 32 byte, base64url không padding. Tạo khóa riêng và giữ qua các lần restart.
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64url'))"
OAUTH_REPLAY_KEY=

# OAuth Rita Võ ID
# Cả bốn biến RITA_* đều bắt buộc.
# API root của A, kết thúc trước /auth/oauth. Chỉ giữ /api nếu A có prefix đó.
# Dùng HTTPS hoặc HTTP qua loopback. npm run dev cũng cho phép HTTP tới IPv4 riêng.
RITA_API_BASE_URL=https://id.example.invalid/api

# Thay bằng ID và secret của OAuth client confidential đã đăng ký tại A.
# Lưu secret thật trong môi trường của C.
RITA_CLIENT_ID=example-client-id
RITA_CLIENT_SECRET=example-client-secret

# Callback B dùng để quay về D. Phải khớp chính xác với URI đăng ký tại A và callback cố định của D.
RITA_REDIRECT_URI=rita-partner-demo://redirect
# Callback của confidential client riêng cho Android Expo Go development.
# RITA_REDIRECT_URI=exp://10.0.2.2:8082/--/redirect
